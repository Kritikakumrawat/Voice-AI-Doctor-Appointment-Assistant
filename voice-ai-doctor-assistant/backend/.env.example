# Copy to backend/.env.  Never commit the real .env file.

# mock = no API keys needed (scripted demo agent, real database)   live = Pipecat + ElevenLabs + Gemini
APP_MODE=mock

# ---- Needed only when APP_MODE=live -----------------------------------------
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=

